# Varelager — environment variables.
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#
# WITHOUT these set, the app runs in Phase 1 local-only mode (localStorage).
# WITH them set, it uses Supabase for shared live data across both phones.

# From Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key

# Optional: gate the app behind one shared passcode (leave blank to disable).
# This is a light lock, not real security — the anon key above is public.
VITE_APP_PASSCODE=
